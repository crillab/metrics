"""
This script automates the analysis of a campaign of experiments with Metrics.
"""
import importlib
import os
import pkgutil
import sys
from argparse import ArgumentParser
from typing import Any, Dict, Tuple

import loguru
import peewee
import sysrsync
from paramiko.client import SSHClient
from pyfiglet import Figlet
from rich.console import Console
from rich.table import Table

import metrics
from metrics.common.util import walk_through_files
from metrics.studio.campaign import CampaignModel
from metrics.studio.constant import METRICS_DIR_EXPERIMENTS

ALIAS_COMMANDS = {
    "c": "campaign",
    "camp": "campaign",
    "solver": "experiment-ware",
    "ew": "experiment-ware",
    "b": "binary",
    "n": "notebook",
    "jupyter": "notebook",
    "ju": "notebook",
    "book": "notebook",
}


#############
# FUNCTIONS #
#############

def discover_and_fill_parsers(package_name, subparser):
    """Découvre les modules d'un package et appelle fill_parser(subparser) pour chacun."""
    package = importlib.import_module(package_name)
    package_path = package.__path__

    # Parcourt les modules du package
    for loader, name, is_pkg in pkgutil.walk_packages(package_path):
        module = importlib.import_module(package_name + '.' + name)

        # Vérifie si le module a une méthode fill_parser
        if hasattr(module, 'fill_parser'):
            # Appelle la méthode fill_parser avec subparser comme argument
            module.fill_parser(subparser)


def parse_arguments() -> Tuple[ArgumentParser, Dict[str, Any]]:
    """
    Parses the command line arguments.

    :return: The parser for the arguments given to Metrics, and the arguments themselves.
    """
    parser = ArgumentParser(prog=metrics.__name__, description=metrics.__summary__, add_help=False)

    subparser = parser.add_subparsers(help="The commands recognized by this script.",
                                      dest="command")

    discover_and_fill_parsers("metrics.command", subparser)

    # Registering the option used to display the help of the program.
    parser.add_argument('-h', '--help',
                        help='displays the help of Metrics',
                        action='store_true')

    # Registering the option used to display the version of the program.
    parser.add_argument('-v', '--version',
                        help='shows the version of Metrics being executed',
                        action='store_true')

    return parser, vars(parser.parse_args())


def print_header() -> None:
    """
    Displays the header of the program, which shows the name of Metrics with big letters.
    """
    figlet = Figlet(font='slant')
    print(figlet.renderText('Metrics'))


def display_help(parser: ArgumentParser) -> None:
    """
    Displays the help of this script.
    """
    print_header()
    parser.print_help()


def version() -> None:
    """
    Displays the current version of Metrics.
    """
    print_header()
    print('Metrics version', metrics.__version__)
    print('Copyright (c)', metrics.__copyright__)
    print('This program is free software: you can redistribute it and/or modify')
    print('it under the terms of the GNU Lesser General Public License.')



def collect(arguments):
    campaign_builder = CampaignFactory.campaign_builder(args, "campaign.yml")
    c = campaign_builder.build()
    remote_campaign_directory = arguments.get("campaign_directory") or c.campaign_dir
    if remote_campaign_directory is None:
        loguru.logger.error(
            "Remote campaign file not found. You must specify the 'campaign-dir' option or initialise the campaign "
            "with 'metrics campaign init'. ")
        sys.exit(1)
    loguru.logger.info(f"Collecting instances with extension(s) '{','.join(arguments['extensions'])}'.")
    with open('./input_set/jobs.lst', 'w') as f:
        files = []
        for file in walk_through_files("./input_set", file_extensions=arguments["extensions"]):
            files.append(os.path.join(remote_campaign_directory, file.replace('./', '')))
    return files




def campaign_init(args):
    loguru.logger.info("Init campaign...")
    campaign_builder = CampaignFactory.campaign_builder(args, "campaign.yml")
    c = campaign_builder.build()
    c.save()


def campaign_upload(args):
    loguru.logger.info("Upload campaign")
    campaign_builder = CampaignFactory.campaign_builder(args, "campaign.yml")
    c = campaign_builder.build()
    sysrsync.run(source=os.getcwd(),
                 destination=c.campaign_dir, destination_ssh=c.ssh_hostname,
                 sync_source_contents=False, options=args["rsync_options"])


def campaign_download(args):
    loguru.logger.info("Download experiments")
    campaign_builder = CampaignFactory.campaign_builder(args, "campaign.yml")
    c = campaign_builder.build()
    sysrsync.run(source=os.path.join(c.campaign_dir, METRICS_DIR_EXPERIMENTS),
                 destination=os.getcwd(), source_ssh=c.ssh_hostname,
                 sync_source_contents=False, options=args["rsync_options"])


def campaign_submit(args):
    campaign_builder = CampaignFactory.campaign_builder(args, "campaign.yml")
    c = campaign_builder.build()

    instances = collect(args)
    ews = experiment_wares_collect(args)
    campaign_upload(args)

    client = SSHClient()
    client.load_system_host_keys()
    client.connect(c.ssh_hostname)
    for instance in instances:
        for ew in ews:
            stdin, stdout, stderr = client.exec_command('')


def campaign_cancel(args):
    pass


def campaign_status(args):
    pass


def campaign_register(args):
    try:
        m = CampaignModel.create(name=args["name"], local_directory=args["dir"])
        m.save()
    except peewee.IntegrityError as e:
        loguru.logger.error(f"Campaign with the path {args['dir']} already exists.")


def campaign_list():
    table = Table(title="Campaign List")
    table.add_column("ID", justify="right")
    table.add_column("Name", justify="right")
    table.add_column("Date", justify="right")
    table.add_column("Local Directory", justify="right")
    table.add_column("Status", justify="right")
    loguru.logger.debug(list(CampaignModel.select()))
    for c in CampaignModel.select():
        table.add_row(str(c.id), c.name, str(c.date), c.local_directory, c.status)
    console = Console()
    console.print(table)


def campaign(args):
    command = args['subcommand']
    loguru.logger.debug(command)
    if command == "init":
        campaign_init(args)
    elif command == "upload":
        campaign_upload(args)
    elif command == "download":
        campaign_download(args)
    elif command == "submit":
        campaign_submit(args)
    elif command == "status":
        campaign_status(args)
    elif command == "cancel":
        campaign_cancel(args)
    elif command == "register":
        campaign_register(args)
    elif command == "list":
        campaign_list()
    else:
        loguru.logger.error(f"'{command}' is not a valid subcommand of 'campaigns'.")


def experiment_wares_collect(args):
    files = []
    for file in os.listdir("./experiment_wares"):
        f = os.path.join("./experiment_wares", file)
        if os.path.isdir(f):
            continue
        if os.access(f, os.X_OK):
            files.append(f)
    loguru.logger.debug(files)
    return files


def experiment_wares(args):
    command = args['subcommand']
    if command == "collect":
        results = experiment_wares_collect(args)
        table = Table(title="Experiment Ware List")
        table.add_column("Name", justify="right")
        for ew in results:
            table.add_row(ew)
        console = Console()
        console.print(table)


################
# MAIN PROGRAM #
################

if __name__ == '__main__':
    # Parsing the command line arguments.
    argument_parser, args = parse_arguments()

    # If the help is asked, we display it and exit.
    if args['help']:
        display_help(argument_parser)
        sys.exit()

    # If the version is asked, we display it and exit.
    if args['version']:
        version()
        sys.exit()

    # Executing the specified Metrics command.
    command = args['command']
    if command == 'help':
        display_help(argument_parser)
    elif command == 'version':
        version()
    else:
        try:
            if command in ALIAS_COMMANDS:
                command = ALIAS_COMMANDS[command]
            module = importlib.import_module("metrics.command." + command.replace("-", "_"))
            if hasattr(module, 'manage_command'):
                module.manage_command(args)
        except TypeError as e:
            loguru.logger.error(f"Command '{command}' not found.")
            loguru.logger.error(e)
    # elif command == 'instances':
    #     instances(args)
    # elif command == 'campaigns':
    #     campaign(args)
    # elif command == "experiment-wares":
    #     experiment_wares(args)
